FROM mcr.microsoft.com/dotnet/sdk:10.0

# The SDK image rather than ubuntu:24.04 for the same reason as the node: the *filter* runs on the
# controller, so the controller needs the net10.0 binary too.
ARG TOOL_VERSION
ARG COLLECTION_SPEC=stop_cran.namespace2xml

# apt rather than pip: on some networks files.pythonhosted.org answers pip with
# SSLV3_ALERT_HANDSHAKE_FAILURE even while pypi.org/simple/ returns 200, and apt is unaffected.
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      ansible-core openssh-client ca-certificates curl python3 \
 && rm -rf /var/lib/apt/lists/* \
 && ansible --version

# The collection under test. rig.ps1 stages something here for every run: this working tree's
# `ansible/` directory for `-Collection local`, a tarball it was pointed at, or nothing at all when
# COLLECTION_SPEC names a published collection. Docker cannot COPY from outside the build context,
# which is why staging is necessary rather than referring to the path directly.
COPY collection /collection

RUN if [ -d /collection/src ]; then \
      ansible-galaxy collection build /collection/src --output-path /collection --force ; \
    fi

# A tarball if one was staged, otherwise whatever COLLECTION_SPEC names -- by default the published
# collection, exactly as an operator would get it.
RUN set -e ; \
    if ls /collection/*.tar.gz >/dev/null 2>&1 ; then \
      target="$(ls /collection/*.tar.gz | head -1)" ; \
    else \
      target="$COLLECTION_SPEC" ; \
    fi ; \
    echo "installing collection: $target" ; \
    ansible-galaxy collection install "$target" --force

RUN ansible-galaxy collection list

COPY pkg /pkg
RUN dotnet tool install --tool-path /usr/local/bin --source /pkg --version "$TOOL_VERSION" namespace2xml \
 && /usr/local/bin/namespace2xml --version

RUN mkdir -p /root/.ssh
COPY .keys/id_rig /root/.ssh/id_rig
RUN chmod 600 /root/.ssh/id_rig

WORKDIR /play
CMD ["sleep", "infinity"]
